server {
    listen 80;
    server_name trainbld.com www.trainbld.com;
    
    location / {
        proxy_pass http://trainbld_website:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    
    location /parse {
        proxy_pass http://trainbld_server:8080/parse;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}